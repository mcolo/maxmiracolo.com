---
import LayoutHalloween from "../../layouts/LayoutHalloween.astro";
import faceImg from '../../assets/halloween/face.jpg';

const slides = [
  { date: '09-18-2026', display: '09/18/26', img: 'https://image.tmdb.org/t/p/w500/nH1lvyQvfbL5GKScTtT6zkIvDEn.jpg', color: 'white', dotColor: 'white', borderColor: '#010101', bg: '#CF1A05' },
  { date: '09/25/2026', display: '09/25/26 - virtual', img: 'https://image.tmdb.org/t/p/w500/jxVGW9g30Vo6aWFyhADjwhfjt59.jpg', color: 'black', dotColor: '#EAD647', borderColor: 'black', bg: '#EAD647' },
  { date: '10-02-2026', display: '10/02/26', img: 'https://image.tmdb.org/t/p/w500/x6rHcQFiYcczLQPrmxXPAicm54E.jpg', color: '#f3190f', dotColor: '#f3190f', borderColor: 'transparent', bg: '#190F17' },
  { date: '10-09-2026', display: '10/09/26', img: 'https://image.tmdb.org/t/p/w500/sfsx06TJuwuK3fWUKe4YnjmqLFj.jpg', color: '#D1360D', dotColor: '#D1360D', borderColor: 'transparent', bg: '#15110D' },
  { date: '10-23-2026', display: '10/23/26', img: 'https://image.tmdb.org/t/p/w500/6rb24x39vV8n5301IelC8rCPJTH.jpg', color: 'black', dotColor: '#03ECE6', borderColor: 'black', bg: '#03ECE6' },
  { isJumpscare: true, color: 'inherit', dotColor: 'transparent', borderColor: 'transparent', bg: '#030303' },
];

const today = new Date();
let idx = slides.findIndex((s) => s.date && today.getTime() <= new Date(s.date).getTime() + 86400000);
if (idx === -1) idx = slides.length - 2;

const current = slides[idx];
const bodyStyle = `--bg:${current.bg};--slide-color:${current.color};--dot-color:${current.dotColor};--border-color:${current.borderColor}`;

const clientSlides = slides.map(({ color, dotColor, borderColor, bg, isJumpscare }) => ({ color, dotColor, borderColor, bg, isJumpscare: !!isJumpscare }));
---
<LayoutHalloween bodyStyle={bodyStyle}>
  <Fragment slot="head">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <link rel="preload" as="image" href={faceImg.src} />
    <meta property="og:title" content="Freaky Friday Schedule" />
    <meta property="og:description" content="🍿👻🎃" />
    <meta property="og:image" content="https://maxmiracolo.com/ff.png" />
  </Fragment>
  <Fragment slot="body">
    <section class="slides" id="slides" data-idx={idx} style={`translate: ${idx * -100}vw`}>
      {slides.map((slide) => (
        <section class="slide">
          {!slide.isJumpscare && <p class="date">{slide.display}</p>}
          {!slide.isJumpscare && <img class="img" src={slide.img} />}
        </section>
      ))}
    </section>
    <div class="dots">
      {slides.slice(0, -1).map((_, i) => (
        <svg data-idx={i} class:list={['dot', { active: i === idx }]} viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"><circle class="circle" cx="50" cy="50" r="50" /></svg>
      ))}
    </div>
    <button class="btn btn--prev" id="slide-prev" hidden={idx === 0}>
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-left">
        <path d="M15 6l-6 6l6 6" />
      </svg>
    </button>
    <button class="btn btn--next" id="slide-next">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-right">
        <path d="M9 6l6 6l-6 6" />
      </svg>
    </button>
  </Fragment>
</LayoutHalloween>

<style define:vars={{ faceImg: `url(${faceImg.src})` }}>
  body {
    width: 100svw;
    height: 100svh;
    overflow: hidden;
    background-color: var(--bg);
    transition: background-color 200ms ease;
  }

  body.jumpscare .dots,
  body.jumpscare .btn {
    opacity: 0;
    pointer-events: none;
  }

  :global(main),
  .slides {
    width: 100%;
    height: 100%;
    will-change: translate;
    display: flex;
    color: var(--slide-color);
    transition: 200ms ease;
  }

  :global(main) {
    --img-w: min(460px, 90vw, calc((100svh - 9rem) * 2 / 3));
    --img-h: calc(var(--img-w) * 3 / 2);
  }

  .slides.no-transition {
    transition: none;
  }

  .slide {
    flex: 0 0 100vw;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: .5rem;
    justify-content: center;
    align-items: center;
  }

  .slide:last-child {
    background-image: var(--faceImg);
    background-repeat: no-repeat;
    background-position: center;
    background-size: 50%;
  }

  body.jumpscare .slide:last-child {
    animation: jumpscare 200ms forwards;
  }

  @keyframes jumpscare {
    from { background-size: 50%; }
    to { background-size: 100%; }
  }

  .date {
    font-family: var(--rubik);
    font-size: 2rem;
  }

  .img {
    width: var(--img-w);
    height: var(--img-h);
    border-style: solid;
    border-width: clamp(5px, 1.5vw, 10px);
    border-color: var(--border-color);
    pointer-events: none;
  }

  .btn {
    position: absolute;
    top: 50%;
    background: none;
    border: none;
    border-radius: 3rem;
    width: 3rem;
    height: 3rem;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .btn path {
    stroke: var(--slide-color);
  }

  .btn[hidden] {
    display: none;
  }

  .btn--next {
    left: calc(50% + (var(--img-w) / 2));
  }

  .btn--prev {
    right: calc(50% + (var(--img-w) / 2));
  }

  .dots {
    display: flex;
    gap: .375rem;
    position: absolute;
    left: 50%;
    translate: -50%;
    padding: .25rem .5rem;
    border-radius: 3rem;
    background-color: #0101017a;
    top: calc(50% + (var(--img-h) / 2) + 2.75rem);
  }

  .dots svg {
    width: .6rem;
    height: .6rem;
  }

  .dots circle {
    opacity: .25;
    fill: var(--dot-color);
  }

  .dot.active circle {
    opacity: 1;
  }

  @media (hover: none) {
    .btn {
      touch-action: none;
    }
    .date {
      pointer-events: none;
    }
  }
</style>

<script define:vars={{ slides: clientSlides }}>
  const slidesEl = document.getElementById('slides');
  let activeIndex = parseInt(slidesEl?.dataset.idx || '0');

  function setSlide(idx, { animate = true } = {}) {
    const clamped = Math.max(0, Math.min(idx, slides.length - 1));
    const el = document.getElementById('slides');
    const prevBtn = document.getElementById('slide-prev');
    if (!el) return;

    if (!animate) el.classList.add('no-transition');

    const w = document.body.clientWidth;
    el.style.translate = `${w * -clamped}px`;
    el.dataset.idx = `${clamped}`;

    if (!animate) requestAnimationFrame(() => el.classList.remove('no-transition'));

    const slide = slides[clamped];
    document.body.style.setProperty('--bg', slide.bg);
    document.body.style.setProperty('--slide-color', slide.color);
    document.body.style.setProperty('--dot-color', slide.dotColor);
    document.body.style.setProperty('--border-color', slide.borderColor);
    document.body.classList.toggle('jumpscare', slide.isJumpscare);

    if (prevBtn) prevBtn.hidden = clamped === 0;

    document.querySelectorAll('.dot').forEach((dot, i) => {
      dot.classList.toggle('active', i === clamped);
    });

    activeIndex = clamped;

    if (slide.isJumpscare) {
      setTimeout(() => setSlide(clamped - 1), 400);
    }
  }

  function handleSlideChange(delta) {
    const next = activeIndex + delta;
    if (next < 0 || next > slides.length - 1) return;
    setSlide(next);
  }

  function addButtonListeners() {
    document.getElementById('slide-prev')?.addEventListener('click', () => handleSlideChange(-1));
    document.getElementById('slide-next')?.addEventListener('click', () => handleSlideChange(1));
  }

  let touchstartX = 0;
  let touchendX = 0;
  let touchstartY = 0;
  let touchendY = 0;

  function checkDirection() {
    const deltaY = touchendY - touchstartY;
    const deltaX = touchendX - touchstartX;
    if (Math.abs(deltaY) >= Math.abs(deltaX)) return;
    if (Math.abs(deltaX) < 50) return;
    if (touchendX < touchstartX) handleSlideChange(1);
    if (touchendX > touchstartX) handleSlideChange(-1);
  }

  function addSwipeListeners() {
    document.addEventListener('touchstart', (e) => {
      touchstartX = e.changedTouches[0].screenX;
      touchstartY = e.changedTouches[0].screenY;
    });

    document.addEventListener('touchend', (e) => {
      touchendX = e.changedTouches[0].screenX;
      touchendY = e.changedTouches[0].screenY;
      checkDirection();
    });
  }

  function addResizeObserver() {
    let rafId = null;

    const resizeObserver = new ResizeObserver((entries) => {
      if (rafId) cancelAnimationFrame(rafId);

      rafId = requestAnimationFrame(() => {
        for (const entry of entries) {
          if (entry.borderBoxSize.length > 0 && activeIndex) {
            setSlide(activeIndex, { animate: false });
          }
        }
        rafId = null;
      });
    });

    resizeObserver.observe(document.body);
  }

  function handleDotClick(e) {
    const idx = e.target.closest('.dot')?.dataset.idx;
    if (!idx) return;
    setSlide(parseInt(idx));
  }

  function addDotListeners() {
    document.querySelectorAll('.dot').forEach((el) => {
      el.addEventListener('click', handleDotClick);
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    addButtonListeners();
    addSwipeListeners();
    addResizeObserver();
    addDotListeners();
  });
</script>
