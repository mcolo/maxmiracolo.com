---
import LayoutHalloween from "../../layouts/LayoutHalloween.astro";

const numSlides = 6;
---
<LayoutHalloween>
  <Fragment slot="head">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
  </Fragment>
  <Fragment slot="body">
    <section class="slides" id="slides" data-idx="0" data-total={numSlides}>
      <section class="slide">
        <p class="date">09/18/26</p>
        <img class="img" src="https://image.tmdb.org/t/p/w500/nH1lvyQvfbL5GKScTtT6zkIvDEn.jpg" />
      </section>
      <section class="slide">
        <p class="date">09/25/26</p>
        <img class="img" src="https://image.tmdb.org/t/p/w500/x6rHcQFiYcczLQPrmxXPAicm54E.jpg" />
      </section>
      <section class="slide">
        <p class="date">10/02/26</p>
        <img class="img" src="https://image.tmdb.org/t/p/w500/jxVGW9g30Vo6aWFyhADjwhfjt59.jpg" />
      </section>
      <section class="slide">
        <p class="date">10/09/26</p>
        <img class="img" src="https://image.tmdb.org/t/p/w500/6rb24x39vV8n5301IelC8rCPJTH.jpg" />
      </section>
      <section class="slide">
        <p class="date">10/23/26</p>
        <img class="img" src="https://image.tmdb.org/t/p/w500/sfsx06TJuwuK3fWUKe4YnjmqLFj.jpg" />
      </section>
      <section class="slide">
      </section>
    </section>
    <div class="dots">
      <svg data-idx="0" class="dot" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"><circle class="circle" cx="50" cy="50" r="50" /></svg>
      <svg data-idx="1" class="dot" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"><circle class="circle" cx="50" cy="50" r="50" /></svg>
      <svg data-idx="2" class="dot" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"><circle class="circle" cx="50" cy="50" r="50" /></svg>
      <svg data-idx="3" class="dot" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"><circle class="circle" cx="50" cy="50" r="50" /></svg>
      <svg data-idx="4" class="dot" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"><circle class="circle" cx="50" cy="50" r="50" /></svg>
      <svg data-idx="5" class="dot" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"><circle class="circle" cx="50" cy="50" r="50" /></svg>
    </div>
    <button class="btn btn--prev" id="slide-prev">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-left">
        <path d="M15 6l-6 6l6 6" />
      </svg>
    </button>
    <button class="btn btn--next" id="slide-next">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-right">
        <path d="M9 6l6 6l-6 6" />
      </svg>
    </button>
  </Fragment>
</LayoutHalloween>

<style>
  body[data-idx="0"] { 
    background-color: #CF1A05;
    color: white; 
    .btn path { stroke: white; }
    .btn--prev { display: none; }
    .img { border-color: #010101; }
    .dots circle { fill: white; }
    .dots svg:nth-child(1) circle { opacity: 1; }
  }

  body[data-idx="1"] { 
    background-color: #190F17;
    color: #f3190f;
    .btn path { stroke: #f3190f; }
    .img { border-color: transparent; }
    .dots circle { fill: #f3190f; }
    .dots svg:nth-child(2) circle { opacity: 1; }
  }

  body[data-idx="2"] { 
    background-color: #EAD647;
    color: black;
    .btn path { stroke: black; }
    .img { border-color: black; }
    .dots circle { fill: #EAD647; }
    .dots svg:nth-child(3) circle { opacity: 1; }
  }

  body[data-idx="3"] { 
    background-color: #03ECE6; 
    color: black; 
    .btn path { stroke: black; }
    .img { border-color: black; }
    .dots circle { fill: #03ECE6; }
    .dots svg:nth-child(4) circle { opacity: 1; }
  }

  body[data-idx="4"] { 
    background-color: #15110D; 
    color: #D1360D; 
    .btn path { stroke: #D1360D; }
    .img { border-color: transparent; }
    .dots circle { fill: #D1360D; }
    .dots svg:nth-child(5) circle { opacity: 1; }
  }
  
  body[data-idx="5"] {
    background: url('../../assets/halloween/face.jpg') no-repeat #030303;
    background-position: center;
    background-size: 100%;
    animation: jumpscare 200ms forwards;
    .btn path { stroke: transparent; }
    .img { border-color: transparent; }
    .dots circle { fill: transparent; }
  }

  @keyframes jumpscare {
    from { background-size: 100%; }
    to { background-size: 150%; }
  }

  body {
    transition: background-color 120ms ease;
    width: 100svw;
    height: 100svh;
    overflow: hidden;
  }

  :global(main),
  .slides {
    width: 100%;
    height: 100%;
    transition: 120ms ease;
    will-change: translate;
    display: flex;
  }

  .slide {
    flex: 0 0 100vw;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: .5rem;
    justify-content: center;
    align-items: center;
  }

  .date {
    font-family: var(--rubik);
    font-size: 2rem;
  }

  .img {
    border-style: solid;
    pointer-events: none;
  }

  .btn {
    position: absolute;
    top: 50%;
    background: none;
    border: none;
    border-radius: 3rem;
    width: 3rem;
    height: 3rem;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .dots {
    display: flex;
    gap: .375rem;
    position: absolute;
    left: 50%;
    translate: -50%;
    padding: .25rem .5rem;
    border-radius: 3rem;
    background-color: #0101017a;
  }

  .dots svg {
    width: .6rem;
    height: .6rem;
  }
  
  .dots circle {
    opacity: .25;
  }

  @media (min-width: 600px) {
    .img {
      width: 460px;
      height: 690px;
      border-width: 10px;
    }
    .dots {
      top: calc(50% + 390px);
    }
    .btn--next {
      left: calc(50% + 230px);
    }

    .btn--prev {
      right: calc(50% + 230px);
    }
  }

  @media (max-width: 600px) and (min-width: 375px) {
    .img {
      width: 300px;
      height: 450px;
      border-width: 7px;
    }
    .dots {
      top: calc(50% + 265px);
    }
    .btn--next {
      left: calc(50% + 150px);
    }

    .btn--prev {
      right: calc(50% + 150px);
   }
  }

  @media (max-width: 375px) {
    .img {
      width: 200px;
      height: 300px;
      border-width: 5px;
      
    }
    .dots {
      top: calc(50% + 190px);
    }
    .btn--next {
      left: calc(50% + 100px);
    }

    .btn--prev {
      right: calc(50% + 100px);
   }
  }
</style>

<script>
  function handleSlideChange(delta: number) {
    const el = document.getElementById('slides');
    if (!el) return;
    const slides = el.dataset.total;
    const idx = document.body.dataset.idx;
    if (!slides || !idx) return;
    const idxNum = parseInt(idx);
    const slidesNum = parseInt(slides);
    let newVal;

    if (delta === -1 && idxNum > 0) {
      newVal = idxNum - 1;
    } else if (delta === 1 && idxNum < slidesNum - 1 ) {
      newVal = idxNum + 1;
    } else {
      return;
    }

    const w = document.body.clientWidth;
    const nextIdx = idxNum + delta;
    const x = w * -1 * nextIdx;

    el.style.translate = `${x}px`;
    document.body.dataset.idx = `${newVal}`;

    if (newVal === 5) {
      setTimeout(() => goToSlide(4), 400);
    }
  }

  function addButtonListeners() {
    document.getElementById('slide-prev')?.addEventListener('click', () => handleSlideChange(-1));
    document.getElementById('slide-next')?.addEventListener('click', () => handleSlideChange(1));
  }

  let touchstartX = 0;
  let touchendX = 0;
  let touchstartY = 0;
  let touchendY = 0;

  function checkDirection() {
    const deltaY = touchendY-touchstartY;
    const deltaX = touchendX-touchstartX;
    console.log(`delta ${deltaX} ${deltaY}`)
    if (Math.abs(deltaY) >= Math.abs(deltaX)) return;
    if (Math.abs(deltaX) < 50) return;
    if (touchendX < touchstartX) handleSlideChange(1);
    if (touchendX > touchstartX) handleSlideChange(-1);
  }

  function addSwipeListeners() {
    document.addEventListener('touchstart', e => {
      touchstartX = e.changedTouches[0].screenX
      touchstartY = e.changedTouches[0].screenY
    });
  
    document.addEventListener('touchend', e => {
      touchendX = e.changedTouches[0].screenX
      touchendY = e.changedTouches[0].screenY
      checkDirection()
    });
  }

  function addResizeObserver() {
    let rafId: null | number = null;

    const resizeObserver = new ResizeObserver((entries) => {
      if (rafId) cancelAnimationFrame(rafId);

      rafId = requestAnimationFrame(() => {
        for (const entry of entries) {
          if (entry.borderBoxSize.length > 0) {
            const idx = document.body.dataset.idx;
            if (!idx) return;
            const idxNum = parseInt(idx);

            const w = document.body.clientWidth;
            const x = w * -1 * idxNum;
            const el = document.getElementById('slides');
            if (!el) return;
            el.style.translate = `${x}px`;
          }
        }
        rafId = null;
      });

    });

    resizeObserver.observe(document.body);
  }

  function goToSlide(idx: number) {
    const w = document.body.clientWidth;
    const x = w * -1 * idx;
    const el = document.getElementById('slides');
    if (!el) return;
    el.style.translate = `${x}px`;
    document.body.dataset.idx = `${idx}`;

    if (idx === 5) {
      setTimeout(() => goToSlide(4), 400);
    }
  }

  function handleDotClick(e: Event) {
    const el = e.target as SVGElement;
    if (!el) return;
    const idx = el.parentElement?.dataset.idx;
    if (!idx) return;
    goToSlide(parseInt(idx));
  }

  function addDotListeners() {
    document.querySelectorAll('.dot').forEach((el) => {
      el.addEventListener('click', handleDotClick);
    })
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.body.dataset.idx = '0';
    addButtonListeners();
    addSwipeListeners();
    addResizeObserver();
    addDotListeners();
  })
</script>